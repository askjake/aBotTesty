import os
import logging
from typing import List, Dict

import httpx

logger = logging.getLogger(__name__)

INTERNAL_SEARCH_URL = os.getenv(
    "INTERNAL_SEARCH_URL",
    "http://internal-search-service.local/api/search",
)

INTERNAL_SEARCH_MODE = os.getenv("INTERNAL_SEARCH_MODE", "service").lower()

CONFLUENCE_BASE_URL = os.getenv(
    "CONFLUENCE_BASE_URL",
    "https://dishtech-dishtv.atlassian.net/wiki",
)
CONFLUENCE_USER_EMAIL = os.getenv("CONFLUENCE_USER_EMAIL")
CONFLUENCE_API_TOKEN = os.getenv("CONFLUENCE_API_TOKEN")


async def _search_confluence(query: str, top_k: int = 5) -> List[Dict]:
    """
    Direct integration with Confluence Cloud search API.

    Returns a list of dicts with: title, url, snippet.
    """
    if not (CONFLUENCE_USER_EMAIL and CONFLUENCE_API_TOKEN):
        logger.warning("Confluence search requested but credentials are missing")
        return []

    # Confluence Cloud search endpoint
    url = CONFLUENCE_BASE_URL.rstrip("/") + "/rest/api/search"

    # Use simpler CQL with proper escaping - split query into words and use AND
    # This is more reliable than the ~ operator with complex phrases
    words = query.split()
    if len(words) > 5:
        # For long queries, just use the first few keywords
        words = words[:5]
    
    # Build CQL with individual word searches
    cql_parts = [f'text ~ "{word}"' for word in words]
    cql = " AND ".join(cql_parts)

    params = {
        "cql": cql,
        "limit": str(top_k),
    }

    auth = httpx.BasicAuth(CONFLUENCE_USER_EMAIL, CONFLUENCE_API_TOKEN)

    try:
        async with httpx.AsyncClient(timeout=10.0, auth=auth) as client:
            resp = await client.get(url, params=params)
            resp.raise_for_status()
            data = resp.json()
    except httpx.HTTPStatusError as e:
        # If CQL still fails, fall back to simple text search
        logger.warning(f"CQL search failed, trying simple search: {e}")
        params = {
            "cql": f'text ~ "{words[0]}"' if words else 'text ~ "RAIL"',
            "limit": str(top_k),
        }
        async with httpx.AsyncClient(timeout=10.0, auth=auth) as client:
            resp = await client.get(url, params=params)
            resp.raise_for_status()
            data = resp.json()

    results: List[Dict] = []
    for item in data.get("results", []):
        # Confluence search results usually have content + _links + excerpt
        content = item.get("content", {}) or {}
        title = content.get("title") or item.get("title") or "Untitled"
        links = content.get("_links", {}) or item.get("_links", {}) or {}
        webui = links.get("webui") or ""
        full_url = CONFLUENCE_BASE_URL.rstrip("/") + webui

        snippet = item.get("excerpt") or ""

        results.append(
            {
                "title": title,
                "url": full_url,
                "snippet": snippet,
            }
        )

    return results


async def _search_via_service(query: str, top_k: int = 5) -> List[Dict]:
    """
    Generic mode: POST to an internal search service that implements:
      POST INTERNAL_SEARCH_URL {query, top_k}
      -> {results: [{title, url, snippet}, ...]}
    """
    payload = {"query": query, "top_k": top_k}
    async with httpx.AsyncClient(timeout=10.0) as client:
        resp = await client.post(INTERNAL_SEARCH_URL, json=payload)
        resp.raise_for_status()
        data = resp.json()

    return data.get("results", [])


async def internal_search(query: str, top_k: int = 5) -> str:
    """
    Internal search tool used by the agent.

    Returns markdown describing top results, or a message if nothing found.
    """
    try:
        mode = INTERNAL_SEARCH_MODE
        if mode == "confluence":
            results = await _search_confluence(query, top_k=top_k)
        else:
            # default: external internal-search-service
            results = await _search_via_service(query, top_k=top_k)

        if not results:
            return (
                "I tried internal search but didn't find anything useful for that query "
                "or the internal search backend isn't configured."
            )

        # Format as markdown list for the assistant bubble
        lines = ["**Internal search results:**", ""]
        for r in results:
            title = r.get("title") or "Untitled"
            url = r.get("url") or ""
            snippet = (r.get("snippet") or "").strip()
            if url:
                lines.append(f"- [{title}]({url})")
            else:
                lines.append(f"- {title}")
            if snippet:
                # Basic cleanup so it doesn't look wild in markdown
                cleaned = snippet.replace("\n", " ").strip()
                lines.append(f"  - {cleaned[:400]}{'…' if len(cleaned) > 400 else ''}")
        return "\n".join(lines)

    except Exception as e:
        logger.error(
            "internal_search failed for query=%r", query, exc_info=True
        )
        return (
            "I tried to use internal search, but the internal search endpoint "
            "is unreachable or misconfigured right now."
        )
