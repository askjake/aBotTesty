# Debug & Local Settings
DEBUG=true
LOCAL=true
AUTH_DISABLED=true

# Primary LLM (for chat)
PLLM_PROVIDER=openai
PLLM_MODEL=gpt-4o

# Evaluation LLM
ELLM_PROVIDER=openai
ELLM_MODEL=gpt-4o-mini

# Embedding Model
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# API Keys (add your own)
OPENAI_API_KEY=your-openai-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GOOGLE_API_KEY=your-google-key-here

# LangGraph Settings
LANGGRAPH_RECURSION_LIMIT=200
# Prompt Caching (Anthropic only - set to 0 for Ollama/OpenAI)
MAX_CACHEPOINT_CNT=0

